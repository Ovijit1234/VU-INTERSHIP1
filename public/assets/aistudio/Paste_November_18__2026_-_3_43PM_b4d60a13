  // --------------------------------------------------------------------------
  // 11. TEST COMPARISON SECTION (FILTER, SORT, PAGINATE, COMPARE TRAY, SAVE)
  // --------------------------------------------------------------------------
  function getFilteredSortedListings() {
    const centreFilter = dom.compareCentreSelect.value;
    const categoryFilter = dom.compareCategorySelect.value;
    const testFilter = dom.compareTestSelect.value;
    const areaFilter = dom.compareAreaSelect.value;
    const keyword = dom.compareKeywordInput.value.trim().toLowerCase();
    const sortBy = dom.compareSortSelect.value;

    let results = getFlattenedTestListings().filter((item) => {
      if (centreFilter !== "all" && item.centreId !== centreFilter) return false;
      if (categoryFilter !== "all" && item.category !== categoryFilter) return false;
      if (testFilter !== "all" && item.testName !== testFilter) return false;
      if (areaFilter !== "all" && item.area !== areaFilter) return false;
      if (keyword) {
        const hay = `${item.testName} ${item.testId} ${item.category} ${item.centreName} ${item.area}`.toLowerCase();
        if (!hay.includes(keyword)) return false;
      }
      return true;
    });

    results.sort((a, b) => {
      if (sortBy === "price-asc") return a.price - b.price;
      if (sortBy === "price-desc") return b.price - a.price;
      if (sortBy === "rating-desc") return b.ratingAvg - a.ratingAvg || a.price - b.price;
      if (sortBy === "name-asc") return a.centreName.localeCompare(b.centreName) || a.price - b.price;
      if (sortBy === "test-asc") return a.testName.localeCompare(b.testName) || a.price - b.price;
      return 0;
    });

    return results;
  }

  function isTestInCompareTray(centreId, testId) {
    return state.compareTray.some((x) => x.centreId === centreId && x.testId === testId);
  }

  function isTestSavedByVisitor(centreId, testId) {
    const visitor = getCurrentVisitor();
    if (!visitor) return false;
    return (visitor.savedTests || []).some((x) => x.centreId === centreId && x.testId === testId);
  }

  function renderComparisonResults() {
    const results = getFilteredSortedListings();
    const total = results.length;
    const totalPages = Math.max(1, Math.ceil(total / COMPARE_PAGE_SIZE));
    if (state.comparePage > totalPages) state.comparePage = totalPages;

    const startIdx = (state.comparePage - 1) * COMPARE_PAGE_SIZE;
    const pageItems = results.slice(startIdx, startIdx + COMPARE_PAGE_SIZE);

    dom.comparisonResultsCount.textContent = `Showing ${total} matching test listing${total === 1 ? "" : "s"}`;
    dom.comparisonPageHint.textContent =
      total > 0
        ? `Displaying ${startIdx + 1}–${startIdx + pageItems.length} of ${total}`
        : "";

    if (pageItems.length === 0) {
      dom.comparisonResultsGrid.innerHTML = `
        <div class="empty-state">
          <p><strong>No matching diagnostic test listings found.</strong></p>
          <p>Try clearing your filters or searching with a broader test keyword.</p>
        </div>
      `;
      dom.comparisonPagination.hidden = true;
      return;
    }

    dom.comparisonResultsGrid.innerHTML = pageItems
      .map((item) => {
        const inTray = isTestInCompareTray(item.centreId, item.testId);
        const isSaved = isTestSavedByVisitor(item.centreId, item.testId);

        return `
          <article class="result-card">
            <div>
              <p class="card-meta-line">${escapeHtml(item.area)} · ${escapeHtml(item.category)} · ${escapeHtml(item.testId)}</p>
              <h3 class="card-title">${escapeHtml(item.centreName)}</h3>
