    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape") {
        document.querySelectorAll(".modal-backdrop:not([hidden])").forEach(closeModal);
      }
    });

    // Legal Modals
    document.querySelectorAll("[data-legal-modal]").forEach((btn) => {
      btn.addEventListener("click", () => {
