              <div class="price-row">
                <span class="price-amount tabular-nums">${formatBDT(item.price)}</span>
                <span class="rating-text">
                  <span class="rating-star">★</span> ${escapeHtml(item.ratingLabel)}
                </span>
              </div>

              <div class="card-details-list">
                <span><strong>Prep:</strong> ${escapeHtml(item.prep)}</span>
                <span><strong>Home Sample:</strong> ${item.homeCollection ? "Available" : "Walk-in Only"}</span>
                <span><strong>Phone:</strong> ${escapeHtml(item.phone)}</span>
              </div>
            </div>

            <div class="card-actions-row">
              <button
                type="button"
                class="btn btn-outline btn-sm ${inTray ? "active" : ""}"
                data-action="toggle-compare"
                data-centre-id="${escapeHtml(item.centreId)}"
                data-test-id="${escapeHtml(item.testId)}"
              >
                ${inTray ? "Compared ✓" : "+ Compare"}
              </button>
              <button
                type="button"
                class="btn btn-outline btn-sm ${isSaved ? "active" : ""}"
                data-action="toggle-save"
                data-centre-id="${escapeHtml(item.centreId)}"
                data-test-id="${escapeHtml(item.testId)}"
              >
                ${isSaved ? "Saved ★" : "Save"}
              </button>
              <button
                type="button"
                class="btn btn-primary btn-sm"
                data-action="view-details"
                data-centre-id="${escapeHtml(item.centreId)}"
              >
                Details
              </button>
            </div>
          </article>
        `;
      })
      .join("");

    // Pagination bar
    dom.comparisonPagination.hidden = totalPages <= 1;
    dom.comparePageInfo.textContent = `Page ${state.comparePage} of ${totalPages}`;
    dom.comparePrevPageBtn.disabled = state.comparePage <= 1;
    dom.compareNextPageBtn.disabled = state.comparePage >= totalPages;
  }

  function renderCompareTray() {
    if (state.compareTray.length === 0) {
      dom.compareTray.hidden = true;
