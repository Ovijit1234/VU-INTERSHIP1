  function updateRoleUI() {
    const visitor = getCurrentVisitor();
    const isAdmin = state.session.role === "admin";

    if (visitor) {
      dom.openAccountBtn.textContent = `Account: ${visitor.name.split(" ")[0]}`;
      dom.openAccountBtn.classList.add("active");
      dom.mobileAccountBtn.textContent = `Visitor Account (${visitor.name})`;
      dom.reviewAccountHint.textContent = `Signed in as Visitor: ${visitor.name}. Your reviews carry a Verified Member badge.`;
      if (!dom.reviewerNameInput.value.trim()) {
        dom.reviewerNameInput.value = visitor.name;
      }
    } else {
      dom.openAccountBtn.textContent = "Sign In";
      dom.openAccountBtn.classList.remove("active");
      dom.mobileAccountBtn.textContent = "Visitor Sign In / Register";
      dom.reviewAccountHint.textContent =
        "Select a diagnostic centre, choose a star rating, and write a short review.";
    }

    if (isAdmin) {
      dom.openAdminBtn.textContent = "Admin Panel (Active)";
      dom.mobileAdminBtn.textContent = "Admin Panel (Active)";
    } else {
      dom.openAdminBtn.textContent = "Admin Login";
