  function parseCsvText(text) {
    const lines = text.replace(/\r\n/g, "\n").replace(/\r/g, "\n").split("\n").filter((l) => l.trim());
    if (lines.length < 2) return [];

    const parseLine = (line) => {
      const cells = [];
      let cur = "";
      let inQuotes = false;
      for (let i = 0; i < line.length; i++) {
        const ch = line[i];
        if (ch === '"') {
          if (inQuotes && line[i + 1] === '"') {
            cur += '"';
            i++;
          } else {
            inQuotes = !inQuotes;
          }
        } else if (ch === "," && !inQuotes) {
          cells.push(cur.trim());
          cur = "";
        } else {
          cur += ch;
        }
      }
      cells.push(cur.trim());
      return cells;
    };

    const headers = parseLine(lines[0]).map((h) => h.toLowerCase().trim());
    const rows = [];
    for (let i = 1; i < lines.length; i++) {
      const values = parseLine(lines[i]);
      const obj = {};
      headers.forEach((h, idx) => {
        obj[h] = values[idx] !== undefined ? values[idx] : "";
      });
      rows.push(obj);
    }
    return rows;
  }

  // Applies normalized import rows by matching test_id or (diagnostic_centre + test_name)
  function applyImportedRows(rawRows) {
    if (!requireAdminRole(dom.adminImportFeedback)) return { updated: 0, added: 0 };

    let updated = 0;
    let added = 0;

    rawRows.forEach((row) => {
      // Normalize flexible column headers
      const norm = {};
      Object.keys(row).forEach((k) => {
        norm[k.toLowerCase().trim()] = row[k];
      });

      const testId = String(norm.test_id || norm.testid || "").trim();
      const centreName = String(norm.diagnostic_centre || norm.hospital || norm.centre || "").trim();
      const branch = String(norm.branch_name || norm.area || "Dhaka").trim();
      const testName = String(norm.test_name || norm.test || "").trim();
      const category = String(norm.normalized_category || norm.category || "General Diagnostics").trim();
      const price = Number(norm.price_bdt ?? norm.price ?? NaN);
      const prep = String(norm.prep_note || norm.prep || "Standard laboratory preparation").trim();

      if (!Number.isFinite(price) || price < 0) return;

      // 1) Try matching existing test by exact test_id anywhere
      if (testId) {
        let matched = false;
        for (const c of state.centres) {
          const existing = c.tests.find((t) => t.testId.toLowerCase() === testId.toLowerCase());
          if (existing) {
            existing.price = Math.round(price);
            if (testName) existing.name = testName;
            if (category) existing.category = category;
            if (norm.prep_note) existing.prep = prep;
            updated++;
            matched = true;
            break;
          }
        }
        if (matched) return;
      }

      // 2) Otherwise find or create hospital and add/update test by testName
      if (!centreName || !testName) return;
      let targetCentre = state.centres.find(
        (c) => c.name.toLowerCase() === centreName.toLowerCase()
      );
      if (!targetCentre) {
        targetCentre = {
          id: `centre-${Date.now()}-${Math.floor(Math.random() * 1000)}`,
          name: centreName,
          area: branch,
          address: `${branch}, Bangladesh`,
          phone: "+880 1700-000000 (Demo)",
          hours: "8:00 AM – 10:00 PM",
          homeCollection: true,
          notes: "Added via Admin dataset import.",
          tests: [],
        };
        state.centres.push(targetCentre);
      }

      const existingByName = targetCentre.tests.find(
        (t) => t.name.toLowerCase() === testName.toLowerCase()
      );
      if (existingByName) {
        existingByName.price = Math.round(price);
        if (category) existingByName.category = category;
        updated++;
      } else {
        targetCentre.tests.push({
          testId: testId || `IMP-${targetCentre.tests.length + 1}`,
          name: testName,
          category,
          price: Math.round(price),
          prep,
        });
        added++;
      }
    });

    saveToStorage(STORAGE_KEYS.centres, state.centres);
    refreshAllUI();
    return { updated, added };
  }

