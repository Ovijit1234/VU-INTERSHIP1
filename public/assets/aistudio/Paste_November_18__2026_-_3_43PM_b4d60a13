      let totalAdded = 0;

      for (const file of files) {
        const ext = file.name.split(".").pop().toLowerCase();
        if (ext === "json") {
          try {
            const parsed = JSON.parse(await file.text());
            if (Array.isArray(parsed) && parsed[0]?.tests) {
              state.centres = parsed;
              saveToStorage(STORAGE_KEYS.centres, state.centres);
              refreshAllUI();
              setFeedback(dom.adminImportFeedback, `Restored full JSON backup (${parsed.length} hospitals).`, "success");
              return;
            }
          } catch (err) {
            setFeedback(dom.adminImportFeedback, `Invalid JSON file: ${file.name}`, "error");
            return;
          }
        } else if (ext === "csv") {
          const rows = parseCsvText(await file.text());
          const res = applyImportedRows(rows);
          totalUpdated += res.updated;
          totalAdded += res.added;
        } else if (ext === "xlsx" || ext === "xls") {
          if (typeof XLSX === "undefined") {
            setFeedback(dom.adminImportFeedback, "Excel parser unavailable offline. Try CSV format.", "error");
            return;
          }
          const data = await file.arrayBuffer();
          const wb = XLSX.read(data, { type: "array" });
          const firstSheet = wb.Sheets[wb.SheetNames[0]];
          const rows = XLSX.utils.sheet_to_json(firstSheet);
          const res = applyImportedRows(rows);
          totalUpdated += res.updated;
          totalAdded += res.added;
        }
      }

      if (pasted) {
        const rows = parseCsvText(pasted);
        const res = applyImportedRows(rows);
        totalUpdated += res.updated;
        totalAdded += res.added;
      }

      dom.importFileInput.value = "";
      dom.importPasteTextarea.value = "";
      setFeedback(
        dom.adminImportFeedback,
        `Import complete: ${totalUpdated} price(s) updated, ${totalAdded} new test(s) added.`,
        "success"
      );
    });
  }

  // --------------------------------------------------------------------------
  // 20. BOOTSTRAP APPLICATION
  // --------------------------------------------------------------------------
  document.addEventListener("DOMContentLoaded", () => {
    initState();
    bindEvents();
    refreshAllUI();
  });
})();

