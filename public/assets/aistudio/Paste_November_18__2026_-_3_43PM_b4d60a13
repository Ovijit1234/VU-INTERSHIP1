  // --------------------------------------------------------------------------
  // 8. COLLECT UNIQUE AREAS, CATEGORIES, AND TESTS
  // --------------------------------------------------------------------------
  function getUniqueAreas() {
    return [...new Set(state.centres.map((c) => c.area).filter(Boolean))].sort();
  }

  function getUniqueCategories() {
    const cats = new Set();
    state.centres.forEach((c) =>
      c.tests.forEach((t) => {
        if (t.category) cats.add(t.category);
      })
    );
    return [...cats].sort();
  }

  function getUniqueTestsWithCategory() {
    const map = new Map();
    state.centres.forEach((c) => {
      c.tests.forEach((t) => {
        if (!map.has(t.name)) {
          map.set(t.name, t.category || "General Diagnostics");
        }
      });
    });
    return [...map.entries()]
      .map(([name, category]) => ({ name, category }))
      .sort((a, b) => a.name.localeCompare(b.name));
  }

  function getFlattenedTestListings() {
    const rows = [];
    state.centres.forEach((centre) => {
      const ratingStats = getCentreRatingStats(centre.id);
      centre.tests.forEach((test) => {
        rows.push({
          centreId: centre.id,
          centreName: centre.name,
          area: centre.area,
          address: centre.address,
          phone: centre.phone,
          homeCollection: centre.homeCollection,
          ratingAvg: ratingStats.avg,
          ratingCount: ratingStats.count,
          ratingLabel: ratingStats.label,
          testId: test.testId,
          testName: test.name,
          category: test.category || "General Diagnostics",
          price: Number(test.price) || 0,
          prep: test.prep || "Standard laboratory preparation",
        });
      });
    });
    return rows;
  }

