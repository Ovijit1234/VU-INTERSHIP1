  // Builds deterministic demonstration dataset of 6 hospitals × 50 tests = 300 rows
  function buildDefaultCentres() {
    return HOSPITAL_TEMPLATES.map((hosp, hIdx) => {
      const tests = BASE_TEST_CATALOG.map((item, tIdx) => {
        // Small deterministic variation per hospital & test rounded to nearest 10 BDT
        const variance = ((hIdx * 7 + tIdx * 3) % 5) * 10 - 20;
        const computedPrice = Math.max(
          100,
          Math.round((item.basePrice * hosp.multiplier + variance) / 10) * 10
        );
        return {
          testId: `${hosp.prefix}-${item.code}`,
          name: item.name,
          category: item.category,
          price: computedPrice,
          prep: item.prep,
        };
      });

      return {
        id: hosp.id,
        name: hosp.name,
        area: hosp.area,
        address: hosp.address,
        phone: hosp.phone,
        hours: hosp.hours,
        homeCollection: hosp.homeCollection,
        notes: hosp.notes,
        tests,
      };
    });
  }

