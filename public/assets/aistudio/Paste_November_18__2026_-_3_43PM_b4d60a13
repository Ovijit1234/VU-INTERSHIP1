  // --------------------------------------------------------------------------
  // 4. SAFE STORAGE & HELPER UTILITIES
  // --------------------------------------------------------------------------
  function loadFromStorage(key, fallbackFactory) {
    try {
      const raw = localStorage.getItem(key);
      if (!raw) return fallbackFactory();
      const parsed = JSON.parse(raw);
      return parsed ?? fallbackFactory();
    } catch (err) {
      return fallbackFactory();
    }
  }

  function saveToStorage(key, value) {
    try {
      localStorage.setItem(key, JSON.stringify(value));
    } catch (err) {
      // Ignore quota errors in private browsing
    }
  }

  function escapeHtml(str) {
    return String(str ?? "")
      .replace(/&/g, "&amp;")
      .replace(/</g, "&lt;")
      .replace(/>/g, "&gt;")
      .replace(/"/g, "&quot;")
      .replace(/'/g, "&#39;");
  }

  function formatBDT(amount) {
    const num = Number(amount) || 0;
    return `৳ ${num.toLocaleString("en-US")}`;
  }

  function setFeedback(el, message, type) {
    if (!el) return;
    el.textContent = message || "";
    el.classList.remove("is-error", "is-success");
    if (type === "error") el.classList.add("is-error");
    if (type === "success") el.classList.add("is-success");
  }

  function getCentreById(centreId) {
    return state.centres.find((c) => c.id === centreId) || null;
  }

  function getCentreRatingStats(centreId) {
    const centreReviews = state.reviews.filter((r) => r.centreId === centreId);
    if (centreReviews.length === 0) {
      return { avg: 0, count: 0, label: "No reviews yet" };
    }
    const sum = centreReviews.reduce((acc, r) => acc + Number(r.rating || 0), 0);
    const avg = sum / centreReviews.length;
    return {
      avg,
      count: centreReviews.length,
      label: `${avg.toFixed(1)} (${centreReviews.length})`,
    };
  }

  function getCurrentVisitor() {
    if (state.session.role !== "visitor" || !state.session.userId) return null;
    return state.users.find((u) => u.id === state.session.userId) || null;
  }

  // Strict Role Guard: blocks ANY admin mutation unless session.role === "admin"
  function requireAdminRole(feedbackEl) {
    if (state.session.role !== "admin") {
      if (feedbackEl) {
        setFeedback(
          feedbackEl,
          "Access denied: Only a signed-in Administrator can modify hospital data.",
          "error"
        );
      }
      return false;
    }
    return true;
  }

